{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plsdo configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "config": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "copy": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["source", "path", "destination", "copy"]
      }
    }
  },
  "required": ["version", "config"]
}
